# ScopePilot AI — Backend Environment Template
# Copy this file to .env and fill in real values before starting the backend.

# ─── Application ─────────────────────────────────────────────────────────────
APP_NAME="ScopePilot AI"
APP_ENV=development
SECRET_KEY=changeme-use-a-long-random-string-here
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
MAX_UPLOAD_SIZE_MB=50

# ─── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_STORAGE_BUCKET=scopepilot-files
SUPABASE_TEMPLATES_BUCKET=scopepilot-templates
SUPABASE_SOW_BUCKET=scopepilot-sow-outputs

# ─── Database (direct connection for migrations) ─────────────────────────────
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ─── AI Provider — set only the provider you want to use ─────────────────────
AI_PROVIDER=openai
# openai | anthropic | google | ollama

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Google Gemini
GOOGLE_API_KEY=AIza...
GOOGLE_MODEL=gemini-1.5-pro

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ─── Document processing ─────────────────────────────────────────────────────
ENABLE_OCR=false
OCR_LANGUAGE=eng
LIBREOFFICE_PATH=soffice

# ─── Redis / Celery (optional, for background jobs) ──────────────────────────
REDIS_URL=redis://localhost:6379/0
USE_CELERY=false

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
